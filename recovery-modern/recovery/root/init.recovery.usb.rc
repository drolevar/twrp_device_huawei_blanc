# ADB-only Huawei recovery USB. The VID/PID and legacy port_mode behavior come
# from the original blanc tree; descriptor readiness comes from modern adbd.
on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

on fs && property:sys.usb.configfs=1
    mkdir /config 0755 root root
    mount configfs none /config
    mkdir /config/usb_gadget/g1
    write /config/usb_gadget/g1/idVendor 0x12d1
    write /config/usb_gadget/g1/idProduct 0x103a
    write /config/usb_gadget/g1/bcdDevice 0x0299
    mkdir /config/usb_gadget/g1/strings/0x409
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1
    write /config/usb_gadget/g1/configs/b.1/MaxPower 0x1f4
    write /config/usb_gadget/g1/configs/b.1/bmAttributes 0xc0
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC none
    stop adbd
    stop fastbootd
    rm /config/usb_gadget/g1/configs/b.1/f1
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.state none

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC none
    # The vendor init.hisi.usb.rc writes os_desc/use 0 on sys.usb.config=none;
    # re-enable Microsoft OS descriptors (WINUSB compatible ID from adbd) while
    # the gadget is unbound, as the working TWRP 3.3.1 gadget setup does.
    write /config/usb_gadget/g1/os_desc/use 1
    # The `on fs && sys.usb.configfs=1` actions (here and in the AOSP init.rc)
    # never fire because sys.usb.configfs is still 0 at `fs`, which left the
    # gadget without iManufacturer/iProduct (host sysfs has no product file;
    # Windows: Code 43 "invalid product description string descriptor").
    # Write them here, while the gadget is unbound.
    mkdir /config/usb_gadget/g1/strings/0x409
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /sys/devices/virtual/android_usb/android0/port_mode 2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state adb

on property:sys.usb.config=sideload && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x103a
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state sideload

on property:sys.usb.config=fastboot && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC none
    stop adbd
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/idVendor 0x12d1
    write /config/usb_gadget/g1/idProduct 0x1057
    mkdir /config/usb_gadget/g1/strings/0x409
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration fastboot
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    mkdir /dev/usb-ffs/fastboot 0770 system system
    mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000
    start fastbootd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=fastboot && property:sys.usb.configfs=1
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /sys/devices/virtual/android_usb/android0/port_mode 2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state fastboot

on fs && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 12d1
    write /sys/class/android_usb/android0/idProduct 103a
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

on property:sys.usb.config=none && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    stop adbd
    stop fastbootd
    setprop sys.usb.state none

on property:sys.usb.config=adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state adb

on property:sys.usb.config=sideload && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state sideload

on property:sys.usb.config=fastboot && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idVendor 12d1
    write /sys/class/android_usb/android0/idProduct 1057
    write /sys/class/android_usb/android0/functions fastboot
    write /sys/class/android_usb/android0/enable 1
    start fastbootd
    setprop sys.usb.state fastboot
