# BLA-L29 recovery-only setup. No TEE or stock storage mounts are started here.
on init
    exec_start blanc_usb_setup

on early-fs
    symlink /dev/block/platform/ff3c0000.ufs /dev/block/bootdevice
    exec_start blanc_fixlinks

on boot
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/policy0/interactive/go_hispeed_load 80
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/hispeed_freq 1863000
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/go_hispeed_load 80
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/target_loads 80
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/timer_rate 20000

# Stock /vendor/etc/init/init.recovery.huawei.rc resets cpu4 to ondemand on boot;
# re-assert interactive on policy4 once USB/ADB config activates after boot.
on property:sys.usb.config=adb
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/hispeed_freq 1863000
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/go_hispeed_load 80
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/target_loads 80
    write /sys/devices/system/cpu/cpufreq/policy4/interactive/timer_rate 20000

on property:sys.powerctl=*
    powerctl ${sys.powerctl}

service blanc_usb_setup /system/bin/sh /sbin/blanc-usb-setup.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service blanc_fixlinks /system/bin/sh /sbin/fixlinks.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Guard against stock /vendor/etc/init/init.recovery.huawei.rc critical vendor
# services (oeminfo_nvm is marked critical in recovery_vendor and triggers a
# 4-crash fatal reboot into fastboot after ~47.7s when left unguarded).
service oeminfo_nvm /system/bin/true
    disabled
    oneshot
    seclabel u:r:recovery:s0

service teecd /system/bin/true
    disabled
    oneshot
    seclabel u:r:recovery:s0
