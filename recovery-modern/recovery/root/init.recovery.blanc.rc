# BLA-L29 recovery-only setup. No TEE or stock storage mounts are started here.
on init
    exec_start blanc_usb_setup

on early-fs
    symlink /dev/block/platform/ff3c0000.ufs /dev/block/bootdevice
    exec_start blanc_fixlinks

service blanc_usb_setup /system/bin/sh /sbin/blanc-usb-setup.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service blanc_fixlinks /system/bin/sh /sbin/fixlinks.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Vendor-service guards:
# LoadBootScripts() in system/core/init/init.cpp parses /system/etc/init/hw/init.rc
# (and its static `import /init.recovery.blanc.rc`) before /vendor/etc/init.
# ServiceParser::EndSection() in system/core/init/service_parser.cpp ignores any
# later duplicate service definition that lacks `override`.
# Defining oeminfo_nvm and teecd here as disabled oneshot no-ops prevents
# /vendor/etc/init/init.recovery.huawei.rc and
# /vendor/etc/init/manufacture/init.recovery.manufacture.rc from registering:
#   - oeminfo_nvm (marked `critical` in recovery_vendor; crashes 4 times in ~47.7s
#     and triggers a fatal reboot to bootloader when started without stock state)
#   - teecd (Huawei TrustZone TEE daemon)
# Consequence: OEMINFO RPC and TrustZone TEE remain inactive in recovery, and
# file-based encryption (FBE) decryption of /data is NOT supported or claimed.
service oeminfo_nvm /system/bin/true
    disabled
    oneshot
    seclabel u:r:recovery:s0

service teecd /system/bin/true
    disabled
    oneshot
    seclabel u:r:recovery:s0
