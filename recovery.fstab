# BLA-L29, measured EMUI 9.1.0.342; unslotted, system-as-root.
# TWRP v1 syntax. This initial candidate enables inspection and raw backups.
# Mounted stock filesystems have no file-backup, wipe, or image-flash target.
# fsflags=ro sets Mount_Read_Only and blocks the normal TWRP restore path.
# See ../FSTAB_NOTES.md for core limitations and the separate data/FBE gate.

/system_root       erofs     /dev/block/bootdevice/by-name/system            flags=display="System";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/vendor            erofs     /dev/block/bootdevice/by-name/vendor            flags=display="Vendor";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/cust              erofs     /dev/block/bootdevice/by-name/cust              flags=display="Cust";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/odm               erofs     /dev/block/bootdevice/by-name/odm               flags=display="ODM";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/product           erofs     /dev/block/bootdevice/by-name/product           flags=display="Product";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/preas             erofs     /dev/block/bootdevice/by-name/preas             flags=display="Preas";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/preavs            erofs     /dev/block/bootdevice/by-name/preavs            flags=display="Preavs";fsflags=ro;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0

# F2FS is measured; Huawei FBE decryption is not implemented by this entry.
# Deliberately disable user wipe/factory-reset and file backup in this candidate.
# norecovery requests no roll-forward replay; actual kernel support is untested.
/data              f2fs      /dev/block/bootdevice/by-name/userdata          flags=display="Data (FBE untested)";fsflags=ro,norecovery;backup=0;flashimg=0;storage=0;settingsstorage=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0

# Cache is measured EXT4. Keep persistent logs/settings read-only for now.
# noload requests no journal replay; use the accompanying core fallback patch.
/cache             ext4      /dev/block/bootdevice/by-name/cache             flags=display="Cache";fsflags=ro,noload;backup=0;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0

# Separate raw-image backup entries preserve bytes rather than EROFS file copies.
# Normal TWRP restore is blocked by ro; normal image flashing is disabled.
/kernel            emmc      /dev/block/bootdevice/by-name/kernel            flags=display="Kernel Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/recovery_ramdisk  emmc      /dev/block/bootdevice/by-name/recovery_ramdisk  flags=display="Recovery Ramdisk Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/recovery_vendor   emmc      /dev/block/bootdevice/by-name/recovery_vendor   flags=display="Recovery Vendor Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/system_image      emmc      /dev/block/bootdevice/by-name/system            flags=display="System Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/vendor_image      emmc      /dev/block/bootdevice/by-name/vendor            flags=display="Vendor Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/cust_image        emmc      /dev/block/bootdevice/by-name/cust              flags=display="Cust Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/odm_image         emmc      /dev/block/bootdevice/by-name/odm               flags=display="ODM Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/product_image     emmc      /dev/block/bootdevice/by-name/product           flags=display="Product Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/preas_image       emmc      /dev/block/bootdevice/by-name/preas             flags=display="Preas Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0
/preavs_image      emmc      /dev/block/bootdevice/by-name/preavs            flags=display="Preavs Image";fsflags=ro;backup=1;flashimg=0;wipeingui=0;wipeduringfactoryreset=0;canbewiped=0

# No guessed boot/ramdisk, MicroSD/OTG wildcard, super, or slot-suffixed entries.
# OEMINFO, misc/BCB, eRecovery, vbmeta, secure storage and NV are not exposed here.
